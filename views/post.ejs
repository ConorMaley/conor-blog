<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
    </nav>
    <main>
        <h1><%= title %></h1>
        <em>Created: <%= new Date(createdDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></em>
        <em>Last edited: <%= new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></em>
        <% if (tags.length) { %>
            <div class="tags">
                <% tags.forEach(tag => { %>
                    <a href="/?tag=<%= tag %>" class="tag"><%= tag %></a>
                <% }) %>
            </div>
        <% } %>
        <article>
            <%- content %>
        </article>
    </main>
</body>
</html>